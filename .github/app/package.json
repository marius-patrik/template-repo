{
  "name": "@canvas/workspace",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "bun run context && rsbuild dev",
    "context": "node scripts/generate-context.mjs",
    "build": "bun run context && rsbuild build",
    "typecheck": "bun run context && tsc --noEmit",
    "check": "bun run context && bun run typecheck && bun run lint && bun run format:check && bun run build",
    "lint": "biome lint . --max-diagnostics=100",
    "format:check": "biome ci . --max-diagnostics=200",
    "format:write": "biome check --write ."
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dockview-react": "^8.7.0",
    "lucide-animated": "1.0.5",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.9.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-hotkeys": "0.17.0",
    "colord": "^2.10.0",
    "react-colorful": "^5.8.1",
    "zustand": "^5.0.8",
    "zod": "^4.1.12",
    "i18next": "^25.6.0",
    "react-i18next": "^16.3.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-context-menu": "^2.2.16",
    "sonner": "^2.0.7",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.0",
    "@rsbuild/plugin-react": "^2.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "@biomejs/biome": "^2.3.0",
    "playwright": "^1.56.0"
  }
